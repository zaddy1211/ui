local count = 0
local function check(name, test) test(); count += 1; print("PASS " .. name) end
check("launch shows a standalone wordmark while the real window remains hidden", function()
    setup(); __KZ_Cozy.Begin()
    local c = __KZ_Cozy
    assert(c.Stage.Parent == Screen and not Window.Visible and not Window.Active)
    assert(c.Cat.Parent == c.Host and c.Host.Parent == c.Stage)
    assert(c.Stage.BackgroundTransparency == 1 and c.Speech == nil)
    for _, node in ipairs(nodes) do assert(node.Name ~= "SpeechBubble" and node.Name ~= "SpeechTail") end
end)
check("the logo is not a square badge inside a circular mask", function()
    setup(); __KZ_Cozy.Begin()
    for _, node in ipairs(__KZ_Cozy.Host:GetDescendants()) do assert(node.ClassName ~= "UICorner") end
    assert(__KZ_Cozy.DockLogo.BackgroundTransparency == 1)
end)
check("progress holds below 100 until real initialization is ready", function()
    setup(); __KZ_Cozy.Begin(); advance(10); __KZ_Cozy.UpdateLoading()
    assert(__KZ_Cozy.DisplayFraction == .96 and not Window.Visible)
    __KZ_Cozy.Progress(3, "Applying saved settings")
    assert(__KZ_Cozy.Status.Text == "Applying saved settings  96%")
end)
check("readiness cannot bypass the minimum logo sequence", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(.5)
    assert(__KZ_Cozy.Active and not Window.Visible)
end)
check("the window expands only after 100 percent and keeps input blocked until settled", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(2.1)
    assert(not Window.Visible and not Window.Active)
    advance(.4)
    assert(Window.Visible and not Window.Active and __KZ_Cozy.Revealing)
    assert(__KZ_Cozy.Status.Text == "Ready  100%")
    advance(.8)
    assert(Window.Visible and Window.Active and not __KZ_Cozy.Active and not __KZ_Cozy.Stage)
end)
check("a ready window receives one successful preference save", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(4)
    assert(__KZ_Cozy.Preferences.SeenIntro and __KZ_Cozy.Saves == 1)
    __KZ_Cozy.Finish(); advance(4); assert(__KZ_Cozy.Saves == 1)
end)
check("success disconnects the launch renderer and viewport listeners", function()
    setup(); __KZ_Cozy.Begin()
    local motion, viewport = __KZ_Cozy.Motion, __KZ_Cozy.IntroViewportConnection
    __KZ_Cozy.Finish(); advance(4)
    assert(not motion.Connected and not viewport.Connected)
end)
check("the compact mark docks to the sidebar at reveal", function()
    setup(); __KZ_Cozy.Begin()
    local original = __KZ_Cozy.GetDockRect
    local position, size = UDim2.fromOffset(124,69), UDim2.fromOffset(44,44)
    __KZ_Cozy.GetDockRect = function() return position, size end
    __KZ_Cozy.DockLogo.Image = "transparent-cat"
    __KZ_Cozy.Finish(); advance(2.6)
    assert(__KZ_Cozy.DockLogo.Position == position and __KZ_Cozy.DockLogo.Size == size)
    assert(__KZ_Cozy.DockLogo.ImageTransparency == 0)
    advance(1)
    __KZ_Cozy.GetDockRect = original
end)
check("missing custom images keep readable fallback branding", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.DockLogo.Image = ""
    assert(__KZ_Cozy.CatFallback.Text == "Mochi Hub")
    __KZ_Cozy.Finish(); advance(2.6)
    assert(__KZ_Cozy.MarkFallback.Visible and __KZ_Cozy.MarkFallback.TextTransparency == 0)
end)
check("reduced motion uses a short fade without window growth or docking", function()
    setup("Soft Kitty", true); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(.6)
    assert(not Window.Visible)
    advance(.7)
    assert(Window.Visible and Window.Active and not __KZ_Cozy.Active)
    assert(Scale.Scale == GetTargetScale())
end)
check("failure never reveals an incomplete interface or saves success", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(true); advance(4)
    assert(not Window.Visible and not Window.Active and not __KZ_Cozy.Active)
    assert(not __KZ_Cozy.Preferences.SeenIntro)
end)
check("unloading while loading releases the standalone overlay", function()
    setup(); __KZ_Cozy.Begin(); local motion = __KZ_Cozy.Motion
    Screen:Destroy(); advance(35)
    assert(not __KZ_Cozy.Active and not motion.Connected and not __KZ_Cozy.Stage)
end)
check("unloading during expansion prevents a late reveal", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(2.6)
    Screen:Destroy(); advance(35)
    assert(not __KZ_Cozy.Active and not Window.Parent and not __KZ_Cozy.Preferences.SeenIntro)
end)
check("watchdog clears a stalled loader and never claims readiness", function()
    setup(); __KZ_Cozy.Begin(); advance(31)
    assert(not __KZ_Cozy.Active and not Window.Visible and #warnings == 1)
end)
check("progress remains monotonic through a slow manual-ready launch", function()
    setup(); __KZ_Cozy.Begin()
    local previous = 0
    for tick = 0, 180 do
        now = tick / 60; __KZ_Cozy.UpdateLoading()
        assert(__KZ_Cozy.DisplayFraction >= previous)
        previous = __KZ_Cozy.DisplayFraction
    end
    assert(previous == .96)
end)
check("the wordmark and loading line fit narrow and landscape viewports", function()
    for _, size in ipairs({{320,568},{390,844},{844,390},{1920,1080}}) do
        setup(); workspace.CurrentCamera.ViewportSize = Vector2.new(size[1],size[2]); __KZ_Cozy.Begin()
        assert(360 * __KZ_Cozy.HostScale.Scale <= size[1] - 40 + .001)
        assert(__KZ_Cozy.LoadingWidth <= size[1] - 48)
        assert(__KZ_Cozy.Host.Position.X.Scale == .5 and __KZ_Cozy.LoadingStrip.Position.X.Scale == .5)
        __KZ_Cozy.Cleanup(false)
    end
end)
check("a viewport change during expansion settles safely once", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(2.6)
    workspace.CurrentCamera.ViewportSize = Vector2.new(390,844); workspace.CurrentCamera.Changed:Fire()
    assert(Window.Visible and Window.Active and not __KZ_Cozy.Stage)
    advance(2); assert(__KZ_Cozy.Saves == 1)
end)
check("the sidebar mark remains hidden while its launch counterpart is docking", function()
    setup(); __KZ_Cozy.Begin(); __KZ_Cozy.Finish(); advance(2.6)
    __KZ_Cozy.SyncBrandLogo(); assert(not BrandLogo.Visible)
    advance(1); __KZ_Cozy.SyncBrandLogo(); assert(BrandLogo.Visible)
end)
check("the unframed mark tracks screen pixels and window fading", function()
    setup(); Window.Visible = true; Window.GroupTransparency = .4
    __KZ_Cozy.BrandFade.Value = .2; __KZ_Cozy.SyncBrandLogo()
    assert(BrandLogo.Size.X.Offset == 44 and BrandLogo.Position.X.Offset == 124)
    assert(math.abs(BrandLogo.ImageTransparency - .52) < .001)
end)
check("late initialization still expands from the logo without artificial extra delay", function()
    setup(); __KZ_Cozy.Begin(); advance(12); __KZ_Cozy.Finish(); advance(1.2)
    assert(Window.Visible and Window.Active and not __KZ_Cozy.Active)
end)
print(tostring(count) .. " launch lifecycle tests passed")
